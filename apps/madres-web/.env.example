# knurl's presentation-service, reachable only over the Railway private network. Missing
# any of these is treated as "gallery not configured yet" and fails closed.
PRESENTATION_SERVICE_BASE_URL=
PRESENTATION_SERVICE_ACCOUNT_ID=
PRESENTATION_SERVICE_GALLERY_NAME=
PRESENTATION_SERVICE_TRACKING_TOKEN=

# Drives the /inquire private-event catering form: every category, option, selection limit
# and price on that page comes from this one JSON document — not from source code. To retune
# the offering (add/remove an option, change a price, adjust min/max picks), edit this value
# and restart/redeploy; it's read fresh from the environment at process start (via
# process.env, same as the presentation-service vars above), so no rebuild is required — on
# Railway that's `railway up`/a service restart picking up the new variable.
#
# All prices are integer cents (30000 = $300.00) — never floating-point dollars.
# `pricingStatus: "DEVELOPMENT"` below marks these as placeholder prices, not
# production-approved ones. Every estimate the form shows is explicitly non-authoritative —
# Madres confirms the real quote after reviewing the inquiry.
#
# Each category also declares its own `inputType` ("SELECT" for a single dropdown pick,
# "CHECKBOX_LIST" for a card of checkboxes) — the widget is config-driven too, not hardcoded
# per category name. "SELECT" requires that category's maxSelections to be exactly 1.
#
# If this var is unset, not valid JSON, or fails schema validation, the inquiry feature is
# treated as off: the "Inquire" nav item and every "Book"/"Book an Event"-style CTA disappear
# site-wide (see src/routes/+layout.server.ts), and /inquire itself renders a safe
# "not available" state instead of a broken form. Must stay on one line for typical .env
# tooling to load it correctly.
PRIVATE_EVENT_OFFERING_JSON={"id":"madres-private-events","version":1,"currency":"USD","pricingStatus":"DEVELOPMENT","pricingTypes":["NONE","PER_EVENT","PER_GUEST"],"baseCharges":[{"id":"base_event_fee","label":"Base event fee","pricingType":"PER_EVENT","priceCents":30000},{"id":"base_food_service","label":"Base food and service","pricingType":"PER_GUEST","priceCents":1500}],"categories":{"guestCount":{"id":"guest_count","label":"Guest Count","minSelections":1,"maxSelections":1,"pricingType":"NONE","options":[{"id":"guest_25_100","label":"25–100","priceCents":0,"facts":{"minimumGuests":25,"maximumGuests":100,"isMinimum":false}},{"id":"guest_101_175","label":"100–175","priceCents":0,"facts":{"minimumGuests":101,"maximumGuests":175,"isMinimum":false}},{"id":"guest_176_250","label":"175–250","priceCents":0,"facts":{"minimumGuests":176,"maximumGuests":250,"isMinimum":false}},{"id":"guest_251_plus","label":"250+","priceCents":0,"facts":{"minimumGuests":251,"maximumGuests":null,"isMinimum":true}}],"inputType":"SELECT"},"serviceDuration":{"id":"service_duration","label":"Service Duration","minSelections":1,"maxSelections":1,"pricingType":"PER_GUEST","options":[{"id":"duration_90","label":"1.5 hours","priceCents":0,"facts":{"durationMinutes":90}},{"id":"duration_120","label":"2 hours","priceCents":100,"facts":{"durationMinutes":120}},{"id":"duration_150","label":"2.5 hours","priceCents":200,"facts":{"durationMinutes":150}},{"id":"duration_180","label":"3 hours","priceCents":300,"facts":{"durationMinutes":180}},{"id":"duration_210","label":"3.5 hours","priceCents":400,"facts":{"durationMinutes":210}},{"id":"duration_240","label":"4 hours","priceCents":500,"facts":{"durationMinutes":240}}],"inputType":"SELECT"},"servingStyle":{"id":"serving_style","label":"Serving Style","minSelections":1,"maxSelections":1,"pricingType":"PER_GUEST","options":[{"id":"taco_truck","label":"Taco Truck Service","priceCents":0},{"id":"buffet","label":"Buffet Service","priceCents":300}],"inputType":"SELECT"},"proteins":{"id":"proteins","label":"Proteins","minSelections":2,"maxSelections":5,"pricingType":"PER_GUEST","selectionPricing":{"includedSelections":2,"includedSelectionStrategy":"HIGHEST_PRICED_SELECTED","chargeRemainingSelections":true},"options":[{"id":"asada","label":"Asada","description":"Beef","priceCents":400},{"id":"adobada","label":"Adobada","description":"Pork","priceCents":300},{"id":"pollo","label":"Pollo","description":"Chicken","priceCents":200},{"id":"chorizo","label":"Chorizo","description":"Pork","priceCents":100},{"id":"veggie","label":"Veggie","description":"Vegetarian taco option","priceCents":100}],"inputType":"CHECKBOX_LIST"},"drinks":{"id":"drinks","label":"Drinks","minSelections":0,"maxSelections":2,"pricingType":"PER_GUEST","options":[{"id":"fruit_infused_water","label":"Fruit-infused water","priceCents":150},{"id":"horchata","label":"Horchata","priceCents":200}],"inputType":"CHECKBOX_LIST"},"appetizers":{"id":"appetizers","label":"Appetizers","minSelections":0,"maxSelections":4,"pricingType":"PER_GUEST","options":[{"id":"flautas","label":"Flautas","description":"Chicken in a hand-rolled tortilla that is deep fried","priceCents":300},{"id":"fruit_cup_spread","label":"Fruit Cup Spread","priceCents":250},{"id":"elote_en_vaso","label":"Elote en Vaso","description":"Also known as Esquites","priceCents":200},{"id":"chorizo_avocado_toast","label":"Chorizo Avocado Toast","priceCents":350}],"inputType":"CHECKBOX_LIST"}},"includedItems":[{"id":"rice","label":"Rice"},{"id":"peruvian_beans","label":"Peruvian beans / habichuela"}],"staffQuotedExtras":[{"id":"travel_surcharge","label":"Travel surcharge"},{"id":"special_protein","label":"Special-request protein"},{"id":"special_request","label":"Other special request"}]}
