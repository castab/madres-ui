# knurl's presentation-service, reachable only over the Railway private network. Missing
# any of these is treated as "gallery not configured yet" and fails closed.
PRESENTATION_SERVICE_BASE_URL=
PRESENTATION_SERVICE_ACCOUNT_ID=
PRESENTATION_SERVICE_GALLERY_NAME=
PRESENTATION_SERVICE_TRACKING_TOKEN=

# Sends the /inquire private-event catering form's staff notification email via Resend's
# HTTP API. RESEND_FROM_EMAIL must be on a domain verified in the Resend account.
# RESEND_TO_EMAIL is the staff inbox that receives every inquiry. Missing any of the three
# is treated as "email not configured yet" and fails closed: the patron sees a generic "try
# again" error and no request is sent to Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@mail.madrestacoshop.com
RESEND_TO_EMAIL=inquire@madrestacoshop.com

# Dev/staging-only safety gate — NEVER set this in production. When set, only a submission
# whose patron-entered email matches this one (case-insensitively) is allowed through; every
# other email fails closed with no send attempted, and no inquiry email goes out. Left unset
# (the default), the gate is off and every submission is allowed through, same as production.
INQUIRY_DEV_ALLOWED_EMAIL=

# Cloudflare Turnstile bot-protection widget on /inquire. PUBLIC_TURNSTILE_SITE_KEY is safe to
# expose to the client (it's not a secret) and is baked in at build time. TURNSTILE_SECRET_KEY
# is used server-side to verify the widget's token before the inquiry is processed — missing it
# fails closed (submissions are rejected) as with every other integration in this app. The
# defaults below are Cloudflare's published test keys (always pass) for local development only
# — replace both with real keys from the Cloudflare dashboard before deploying to production.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Drives the /inquire private-event catering form: every category, option, selection limit
# and price on that page comes from this one JSON document — not from source code. To retune
# the offering (add/remove an option, change a price, adjust min/max picks), edit this value
# and restart/redeploy; it's read fresh from the environment at process start (via
# process.env, same as the presentation-service vars above), so no rebuild is required — on
# Railway that's `railway up`/a service restart picking up the new variable.
#
# The JSON below is entirely fictional test data. Keep real options and prices only in
# your private .env and deployment environment; never copy production values here.
# All prices are integer cents (1000 = $10.00), never floating-point dollars.
# Every estimate the form shows is preliminary and subject to staff confirmation.
#
# Each category also declares its own `inputType` ("SELECT" for a single dropdown pick,
# "CHECKBOX_LIST" for a card of checkboxes) — the widget is config-driven too, not hardcoded
# per category name. "SELECT" requires that category's maxSelections to be exactly 1.
# "QUANTITY_LIST" uses each option's `priceCents` as a per-item price. A zero or blank
# quantity means none; ordering any items must meet `minimumOrderCents` ($100 in this example).
# `maximumQuantityPerOption` caps each entered quantity.
# An option's optional `description` appears in its chip's info popover; omit it to hide the icon.
#
# `guestCountField` is a numeric input with a configurable maximum guest count;
# the estimate uses the exact number entered. Each serving style's `priceCents` is its
# full per-guest rate; `minimumEventCents` is the event floor. The estimate uses the larger
# of the floor and the serving-style total, then adds any add-ons. There are no base charges.
# Option `description` text appears in each option's info popover.
# `includedItems` describes example included content; `excludedServingStyleIds` shows how
# one style can omit selected content.
#
# `additionalNotesField` defines the one free-text notes field on the form (its
# label and placeholder come from here, not source code) — `inputType` currently only
# supports "TEXTAREA".
#
# If this var is unset, not valid JSON, or fails schema validation, the inquiry feature is
# treated as off: the "Inquire" nav item and every "Book"/"Book an Event"-style CTA disappear
# site-wide (see src/routes/+layout.server.ts), and /inquire itself renders a safe
# "not available" state instead of a broken form. Must stay on one line for typical .env
# tooling to load it correctly.
PRIVATE_EVENT_OFFERING_JSON={"id":"sample-event-offering","version":1,"currency":"USD","pricingStatus":"EXAMPLE","pricingTypes":["NONE","PER_EVENT","PER_GUEST","PER_ITEM"],"guestCountField":{"id":"attendee_count","label":"Attendees","inputType":"NUMBER","maximumGuests":999,"placeholder":"Enter an attendee count"},"categories":{"servingStyle":{"id":"service_style","label":"Service Style","minSelections":1,"maxSelections":1,"pricingType":"PER_GUEST","inputType":"SELECT","options":[{"id":"style_a","label":"Service A","description":"Example service style A.","priceCents":1000,"minimumEventCents":10000},{"id":"style_b","label":"Service B","description":"Example service style B.","priceCents":1200,"minimumEventCents":20000},{"id":"style_c","label":"Service C","description":"Example service style C.","priceCents":800,"minimumEventCents":8000}]},"proteins":{"id":"fillings","label":"Fillings","minSelections":2,"maxSelections":5,"pricingType":"PER_GUEST","inputType":"CHECKBOX_LIST","selectionPricing":{"includedSelections":2,"includedSelectionStrategy":"HIGHEST_PRICED_SELECTED","chargeRemainingSelections":true},"options":[{"id":"filling_a","label":"Filling A","description":"Example filling A.","priceCents":200},{"id":"filling_b","label":"Filling B","description":"Example filling B.","priceCents":150},{"id":"filling_c","label":"Filling C","description":"Example filling C.","priceCents":100},{"id":"filling_d","label":"Filling D","description":"Example filling D.","priceCents":50},{"id":"filling_e","label":"Filling E","description":"Example filling E.","priceCents":25}]},"drinks":{"id":"beverages","label":"Beverages","minSelections":0,"maxSelections":2,"pricingType":"PER_GUEST","inputType":"CHECKBOX_LIST","options":[{"id":"beverage_a","label":"Beverage A","description":"Example beverage A.","priceCents":75},{"id":"beverage_b","label":"Beverage B","description":"Example beverage B.","priceCents":125}]},"appetizers":{"id":"items","label":"Items","minSelections":0,"maxSelections":4,"pricingType":"PER_ITEM","inputType":"QUANTITY_LIST","minimumOrderCents":10000,"maximumQuantityPerOption":1000,"options":[{"id":"item_a","label":"Item A","description":"Example item A.","priceCents":200},{"id":"item_b","label":"Item B","description":"Example item B.","priceCents":300},{"id":"item_c","label":"Item C","description":"Example item C.","priceCents":400},{"id":"item_d","label":"Item D","description":"Example item D.","priceCents":500}]}},"includedItems":[{"id":"included_setup","label":"Included Setup","description":"Example included setup.","contents":[{"label":"Component A","excludedServingStyleIds":["style_c"]},{"label":"Component B","excludedServingStyleIds":["style_c"]},{"label":"Shared supplies"}]}],"staffQuotedExtras":[{"id":"custom_extra","label":"Custom extra"}],"additionalNotesField":{"id":"additional_notes","label":"Other details","inputType":"TEXTAREA","placeholder":"Add any extra details"}}
