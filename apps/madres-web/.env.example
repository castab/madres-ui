# knurl's presentation-service, reachable only over the Railway private network. Missing
# any of these is treated as "gallery not configured yet" and fails closed.
PRESENTATION_SERVICE_BASE_URL=
PRESENTATION_SERVICE_ACCOUNT_ID=
PRESENTATION_SERVICE_GALLERY_NAME=
PRESENTATION_SERVICE_TRACKING_TOKEN=

# Sends the /inquire private-event catering form's staff notification email via Resend's
# HTTP API. RESEND_FROM_EMAIL must be on a domain verified in the Resend account.
# RESEND_TO_EMAIL is the staff inbox that receives every inquiry. Missing any of the three
# is treated as "email not configured yet" and fails closed: the patron sees a generic "try
# again" error and no request is sent to Resend.
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@mail.madrestacoshop.com
RESEND_TO_EMAIL=inquire@madrestacoshop.com

# Dev/staging-only safety gate — NEVER set this in production. When set, only a submission
# whose patron-entered email matches this one (case-insensitively) is allowed through; every
# other email fails closed with no send attempted, and no inquiry email goes out. Left unset
# (the default), the gate is off and every submission is allowed through, same as production.
INQUIRY_DEV_ALLOWED_EMAIL=

# Cloudflare Turnstile bot-protection widget on /inquire. PUBLIC_TURNSTILE_SITE_KEY is safe to
# expose to the client (it's not a secret) and is baked in at build time. TURNSTILE_SECRET_KEY
# is used server-side to verify the widget's token before the inquiry is processed — missing it
# fails closed (submissions are rejected) as with every other integration in this app. The
# defaults below are Cloudflare's published test keys (always pass) for local development only
# — replace both with real keys from the Cloudflare dashboard before deploying to production.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Drives the /inquire private-event catering form: every category, option, selection limit
# and price on that page comes from this one JSON document — not from source code. To retune
# the offering (add/remove an option, change a price, adjust min/max picks), edit this value
# and restart/redeploy; it's read fresh from the environment at process start (via
# process.env, same as the presentation-service vars above), so no rebuild is required — on
# Railway that's `railway up`/a service restart picking up the new variable.
#
# All prices are integer cents (30000 = $300.00) — never floating-point dollars.
# `pricingStatus: "DEVELOPMENT"` below marks these as placeholder prices, not
# production-approved ones. Every estimate the form shows is explicitly non-authoritative —
# Madres confirms the real quote after reviewing the inquiry.
#
# Each category also declares its own `inputType` ("SELECT" for a single dropdown pick,
# "CHECKBOX_LIST" for a card of checkboxes) — the widget is config-driven too, not hardcoded
# per category name. "SELECT" requires that category's maxSelections to be exactly 1.
#
# `guestCountField` is a numeric input with configurable minimum and maximum guest counts;
# the estimate uses the exact number entered. Serving styles set `minimumEventCents`;
# the estimate uses the larger of that floor and the itemized total.
# `includedItems` describes the Styled Tablescape and its freshly made contents. Guests
# can request exceptions in "Anything else?".
#
# `additionalNotesField` defines the one free-text "Anything else?" field on the form (its
# label and placeholder come from here, not source code) — `inputType` currently only
# supports "TEXTAREA".
#
# If this var is unset, not valid JSON, or fails schema validation, the inquiry feature is
# treated as off: the "Inquire" nav item and every "Book"/"Book an Event"-style CTA disappear
# site-wide (see src/routes/+layout.server.ts), and /inquire itself renders a safe
# "not available" state instead of a broken form. Must stay on one line for typical .env
# tooling to load it correctly.
PRIVATE_EVENT_OFFERING_JSON={"id":"madres-private-events","version":3,"currency":"USD","pricingStatus":"DEVELOPMENT","pricingTypes":["NONE","PER_EVENT","PER_GUEST"],"baseCharges":[{"id":"base_event_fee","label":"Base event fee","pricingType":"PER_EVENT","priceCents":30000},{"id":"base_food_service","label":"Base food and service","pricingType":"PER_GUEST","priceCents":1500}],"categories":{"servingStyle":{"id":"serving_style","label":"Serving Style","minSelections":1,"maxSelections":1,"pricingType":"PER_GUEST","options":[{"id":"taco_truck","label":"Taco Truck Service","priceCents":0,"minimumEventCents":75000},{"id":"buffet","label":"Buffet Service","priceCents":300,"minimumEventCents":100000},{"priceCents":0,"label":"Other","id":"other","minimumEventCents":55000,"description":"Tell us what you have in mind in Anything else?"}],"inputType":"SELECT"},"proteins":{"id":"proteins","label":"Proteins","minSelections":2,"maxSelections":5,"pricingType":"PER_GUEST","selectionPricing":{"includedSelections":2,"includedSelectionStrategy":"HIGHEST_PRICED_SELECTED","chargeRemainingSelections":true},"options":[{"id":"asada","label":"Asada","description":"Beef","priceCents":400},{"id":"adobada","label":"Adobada","description":"Pork","priceCents":300},{"id":"pollo","label":"Pollo","description":"Chicken","priceCents":200},{"id":"chorizo","label":"Chorizo","description":"Pork","priceCents":100},{"id":"veggie","label":"Veggie","description":"Vegetarian taco option","priceCents":100}],"inputType":"CHECKBOX_LIST"},"drinks":{"id":"drinks","label":"Drinks","minSelections":0,"maxSelections":2,"pricingType":"PER_GUEST","options":[{"id":"fruit_infused_water","label":"Fruit-infused water","priceCents":150},{"id":"horchata","label":"Horchata","priceCents":200}],"inputType":"CHECKBOX_LIST"},"appetizers":{"id":"appetizers","label":"Appetizers","minSelections":0,"maxSelections":4,"pricingType":"PER_GUEST","options":[{"id":"flautas","label":"Flautas","description":"Chicken in a hand-rolled tortilla that is deep fried","priceCents":300},{"id":"fruit_cup_spread","label":"Fruit Cup Spread","priceCents":250},{"id":"elote_en_vaso","label":"Elote en Vaso","description":"Also known as Esquites","priceCents":200},{"id":"chorizo_avocado_toast","label":"Chorizo Avocado Toast","priceCents":350}],"inputType":"CHECKBOX_LIST"}},"includedItems":[{"id":"styled_tablescape","label":"Styled Tablescape","description":"A decorated table themed to match your event, with everything freshly made for the occasion.","contents":["Rice","Beans","Chips","Taco toppings: chopped white onion, red salsa, green salsa, guacamole salsa, cilantro, sliced limes, sliced cucumbers, and chopped cabbage"]}],"staffQuotedExtras":[{"id":"travel_surcharge","label":"Travel surcharge"},{"id":"special_protein","label":"Special-request protein"},{"id":"special_request","label":"Other special request"}],"additionalNotesField":{"id":"additional_notes","label":"Anything else?","inputType":"TEXTAREA","placeholder":"Allergies, theme, timing constraints, anything else we should know…"},"guestCountField":{"id":"guest_count","label":"Guest Count","inputType":"NUMBER","minimumGuests":15,"maximumGuests":10000,"placeholder":"Enter your estimated guest count"}}
